{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npx jest:*)", "Bash(pytest:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chanGhiNgoaiTest.js\"" }
        ]
      }
    ]
  }
}
