CONG=5000

CSDL_HOST=localhost
CSDL_CONG=3307
CSDL_NGUOI_DUNG=root
CSDL_MAT_KHAU=
CSDL_TEN=quanlydoanhnghiepthongminh

# BẮT BUỘC đổi: tối thiểu 32 ký tự, server từ chối khởi động nếu giữ giá trị mẫu này.
# Tạo chuỗi: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_BI_MAT=thay-bang-chuoi-ngau-nhien-dai
JWT_HET_HAN=8h

# Origin được gọi API kèm cookie đăng nhập, phân cách bằng dấu phẩy (dev qua proxy Vite không cần đổi)
CORS_NGUON=http://localhost:5173

AI_SERVICE_URL=http://localhost:8000

# Khóa nội bộ gọi ai-service (header X-Khoa-Noi-Bo), tối thiểu 32 ký tự, PHẢI trùng AI_SERVICE_KEY của ai-service/.env
# Tạo chuỗi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_KEY=
# Thời gian chờ ai-service (ms); quá hạn trả 503 thân thiện
AI_TIMEOUT_MS=30000
