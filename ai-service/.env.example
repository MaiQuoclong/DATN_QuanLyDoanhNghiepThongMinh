CONG=8000

# Khóa nội bộ: PHẢI trùng AI_SERVICE_KEY của backend/.env, tối thiểu 32 ký tự (thiếu -> /noiBo/* trả 503)
AI_SERVICE_KEY=

# Tài khoản MySQL CHỈ ĐỌC cho Text-to-SQL (tạo bằng database/taoTaiKhoanChiDoc.sql)
CSDL_HOST=127.0.0.1
CSDL_CONG=3307
CSDL_NGUOI_DUNG=aiReadonly
CSDL_MAT_KHAU=
CSDL_TEN=quanlydoanhnghiepthongminh

# LLM (Module 5 - AI Agent)
ANTHROPIC_API_KEY=
MO_HINH_LLM=claude-haiku-5-5
LLM_TIMEOUT_GIAY=25

# RAG (Module 5.3): thư mục tệp quy chế PHẢI trùng THU_MUC_TAI_LIEU của backend (đường dẫn tương đối tính từ ai-service/)
THU_MUC_TAI_LIEU=../backend/uploads/quyChe
DUONG_DAN_CHROMA=duLieu/chroma
DUONG_DAN_LICH_SU=duLieu/lichSu.db
# Model embedding local (sentence-transformers, cài requirements-nhung.txt; lần đầu tải ~1.1GB). "gia" = embedding giả cho test
MO_HINH_NHUNG=intfloat/multilingual-e5-base
# Điểm tương đồng cosine tối thiểu để coi là tìm thấy (dưới ngưỡng: trả "không tìm thấy", không gọi LLM)
NGUONG_DIEM_RAG=0.78
